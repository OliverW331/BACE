# Track only the main experiment, its results and supporting documentation.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/BACE/
!/docs/
!/paper/

/docs/*
!/docs/REPOSITORY.md
!/docs/generation_evaluation.md
!/docs/generation_claim_support_assessment.md
!/docs/generation_claim_unsupported_diagnosis.md

/paper/*
!/paper/reports/
/paper/reports/*
!/paper/reports/main_experiment_2026-11-02/
/paper/reports/main_experiment_2026-11-02/review/
/paper/reports/main_experiment_2026-11-02/*.log

# Python
.venv/
.venv-external-evaluation/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local configuration and secrets
.env
.env.*
*.key
*.pem

# Caches and generated experiment artifacts
.cache/
data/
evidence_pilot/
generation_outputs/
logs/

# OS and editor files
.DS_Store
.vscode/
*~
*.swp
*.swo
