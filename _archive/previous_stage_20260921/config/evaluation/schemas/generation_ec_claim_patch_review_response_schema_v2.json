{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generation_ec_claim_patch_review_response_v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "evidence_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "prompt_label": {
            "type": "string"
          },
          "edits": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "claims": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "claim_text": {
                        "type": "string"
                      },
                      "source_quotes": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "unresolved_context": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "claim_text",
                      "source_quotes",
                      "unresolved_context"
                    ]
                  }
                },
                "reason": {
                  "type": "string"
                },
                "replaces": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "claim_id": {
                        "type": "string"
                      },
                      "expected_claim_text": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "claim_id",
                      "expected_claim_text"
                    ]
                  }
                }
              },
              "required": [
                "replaces",
                "claims",
                "reason"
              ]
            }
          },
          "additions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "claim_text": {
                  "type": "string"
                },
                "source_quotes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "unresolved_context": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "claim_text",
                "source_quotes",
                "unresolved_context"
              ]
            }
          },
          "exclusion_update": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "unextracted_spans": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "source_quotes": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "reason": {
                          "type": "string",
                          "enum": [
                            "document_structure",
                            "extraction_metadata",
                            "missing_proposition"
                          ]
                        },
                        "explanation": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "source_quotes",
                        "reason",
                        "explanation"
                      ]
                    }
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "unextracted_spans",
                  "reason"
                ]
              }
            ]
          }
        },
        "required": [
          "prompt_label",
          "edits",
          "additions",
          "exclusion_update"
        ]
      }
    }
  },
  "required": [
    "evidence_results"
  ]
}
