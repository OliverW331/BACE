{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generation_ec_claim_focused_context_response_v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "evidence_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "prompt_label": {
            "type": "string"
          },
          "edits": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "claims": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "claim_text": {
                        "type": "string"
                      },
                      "source_quotes": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "unresolved_context": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "claim_text",
                      "source_quotes",
                      "unresolved_context"
                    ]
                  },
                  "minItems": 1,
                  "maxItems": 1
                },
                "reason": {
                  "type": "string"
                },
                "replaces": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "claim_id": {
                        "type": "string"
                      },
                      "expected_claim_text": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "claim_id",
                      "expected_claim_text"
                    ]
                  },
                  "maxItems": 1
                }
              },
              "required": [
                "replaces",
                "claims",
                "reason"
              ]
            }
          },
          "additions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "claim_text": {
                  "type": "string"
                },
                "source_quotes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "unresolved_context": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "claim_text",
                "source_quotes",
                "unresolved_context"
              ]
            },
            "maxItems": 0
          },
          "exclusion_update": {
            "type": "null"
          }
        },
        "required": [
          "prompt_label",
          "edits",
          "additions",
          "exclusion_update"
        ]
      }
    }
  },
  "required": [
    "evidence_results"
  ]
}
