{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generation_dc_claim_patch_review_response_v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "edits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "replace_indices": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "claim_text": {
                  "type": "string"
                },
                "source_quotes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "context_resolutions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "surface_form": {
                        "type": "string"
                      },
                      "resolved_value": {
                        "type": "string"
                      },
                      "metadata_field": {
                        "type": "string",
                        "enum": [
                          "company_name",
                          "target_reporting_year"
                        ]
                      }
                    },
                    "required": [
                      "surface_form",
                      "resolved_value",
                      "metadata_field"
                    ]
                  }
                },
                "unresolved_context": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "claim_text",
                "source_quotes",
                "context_resolutions",
                "unresolved_context"
              ]
            }
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "replace_indices",
          "claims",
          "reason"
        ]
      }
    },
    "additions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim_text": {
            "type": "string"
          },
          "source_quotes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "context_resolutions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "surface_form": {
                  "type": "string"
                },
                "resolved_value": {
                  "type": "string"
                },
                "metadata_field": {
                  "type": "string",
                  "enum": [
                    "company_name",
                    "target_reporting_year"
                  ]
                }
              },
              "required": [
                "surface_form",
                "resolved_value",
                "metadata_field"
              ]
            }
          },
          "unresolved_context": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "claim_text",
          "source_quotes",
          "context_resolutions",
          "unresolved_context"
        ]
      }
    },
    "unextracted_spans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_quotes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string",
            "enum": [
              "document_structure",
              "extraction_metadata",
              "missing_proposition"
            ]
          },
          "explanation": {
            "type": "string"
          }
        },
        "required": [
          "source_quotes",
          "reason",
          "explanation"
        ]
      }
    },
    "no_claim_reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "no_evaluable_factual_proposition",
        "insufficient_context_or_extraction_noise"
      ]
    }
  },
  "required": [
    "edits",
    "additions",
    "unextracted_spans",
    "no_claim_reason"
  ]
}
